# Dashboard (static SPA) — build with Vite+, serve with unprivileged nginx.
# Build context is the monorepo root:  podman build -f dashboard/Containerfile .
FROM docker.io/library/node:24-alpine AS builder

RUN npm install -g pnpm@12.3.4

WORKDIR /build

# Workspace manifests first for layer caching.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY dashboard/package.json dashboard/package.json
RUN pnpm install --frozen-lockfile --filter dashboard...

# Sources, then compile. API base URL is baked in at build time.
COPY dashboard/ dashboard/
ARG VITE_API_BASE_URL=http://localhost:3000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN pnpm --filter dashboard build

FROM docker.io/nginxinc/nginx-unprivileged:alpine

COPY dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dashboard/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:8080/ || exit 1
