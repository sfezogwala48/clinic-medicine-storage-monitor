# Server
PORT=3000

# Logging: level one of verbose|debug|log|warn|error|fatal (default: debug, or log in production).
# Format one of pretty|json (default: pretty, or json in production).
LOG_LEVEL=debug
LOG_FORMAT=pretty

# SQLite (better-sqlite3). Use ":memory:" for hermetic tests.
DATABASE_PATH=./data/app.sqlite
# Auto-sync schema on boot. Keep "true" for local dev; use migrations in production.
DB_SYNCHRONIZE=true
# SQL query logging.
DB_LOGGING=false

# Browser clients allowed to call the API (comma-separated). Empty reflects
# the request origin; "*" allows all. Compose sets this to the dashboard URL.
# CORS_ORIGINS=http://localhost:9100

# MQTT broker (mosquitto) for the telemetry microservice.
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=clinic-monitor-server

# Auth: HS256 JWT signing secret (REQUIRED in production — set a long random
# value). The seeded demo passwords below apply on first boot only.
# JWT_SECRET=change-me-to-a-long-random-secret
# JWT_EXPIRES_IN=12h
# SEED_ADMIN_PASSWORD=Admin123!

# EmailJS (server-side alert emails via https://api.emailjs.com).
# Get these from https://dashboard.emailjs.com (Account > General for keys,
# Email Services / Email Templates for the IDs). The private key stays on the
# server — never prefix it with VITE_ or ship it to the browser.
# EMAILJS_PUBLIC_KEY=your-public-key
# EMAILJS_PRIVATE_KEY=your-private-key
# EMAILJS_SERVICE_ID=service_xxxxxxx
# EMAILJS_TEMPLATE_ID=template_xxxxxxx
