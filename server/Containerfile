# Server (NestJS API) — multi-stage build, minimal Alpine runtime.
# Build context is the monorepo root:  podman build -f server/Containerfile .
FROM docker.io/library/node:24-alpine AS builder

# better-sqlite3 compiles from source (node-gyp); toolchain stays in this stage.
RUN apk add --no-cache python3 make g++ git \
  && npm install -g pnpm@12.3.4

# No git repo inside the build context; skip hook installation.
ENV VP_GIT_HOOKS=0

WORKDIR /build

# Workspace manifests first for layer caching.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY server/package.json server/package.json
RUN pnpm install --frozen-lockfile --filter server...

# Sources + build configs, then compile.
COPY server/ server/
RUN pnpm --filter server build

# Standalone prod bundle (prod node_modules only), plus compiled output.
RUN pnpm --filter server deploy /app --prod \
  && cp -r /build/server/dist /app/dist \
  && cp /build/server/healthcheck.mjs /app/healthcheck.mjs \
  && rm -rf /app/src /app/test

FROM docker.io/library/node:24-alpine

RUN apk add --no-cache su-exec

ENV NODE_ENV=production

WORKDIR /app

COPY --from=builder --chown=node:node /app /app
COPY server/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "/app/healthcheck.mjs"]

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["node", "dist/main.js"]
