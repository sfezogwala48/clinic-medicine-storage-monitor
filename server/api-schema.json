{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_liveness",
        "parameters": [],
        "responses": { "200": { "description": "Process is up" } },
        "summary": "Liveness probe (no dependency checks)",
        "tags": ["health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful\n\nAll dependencies healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["ok", "degraded"], "example": "ok" },
                    "info": {
                      "type": "object",
                      "example": { "database": { "status": "up", "responseTime": 12 } },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": { "database": { "status": "up", "responseTime": 12 } },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful\n\nOne or more dependencies unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["error", "shutting_down"],
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": { "database": { "status": "up", "responseTime": 12 } },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": { "status": "up", "responseTime": 12 },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": ["status"],
                        "properties": {
                          "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Readiness probe (sqlite, MQTT, disk, memory)",
        "tags": ["health"]
      }
    },
    "/telemetry/latest": {
      "get": {
        "operationId": "TelemetryHttpController_getLatest",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Latest readings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ReadingDto" }
                }
              }
            }
          }
        },
        "summary": "Latest reading per storage device (in-memory)",
        "tags": ["telemetry"]
      }
    },
    "/telemetry/latest/{deviceId}": {
      "get": {
        "operationId": "TelemetryHttpController_getLatestById",
        "parameters": [
          {
            "name": "deviceId",
            "required": true,
            "in": "path",
            "schema": { "example": "fridge-01", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest reading",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ReadingDto" } }
            }
          },
          "404": { "description": "No readings for this device yet" }
        },
        "summary": "Latest reading for one storage device",
        "tags": ["telemetry"]
      }
    },
    "/telemetry/publish": {
      "post": {
        "operationId": "TelemetryHttpController_publish",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PublishReadingDto" } }
          }
        },
        "responses": {
          "201": {
            "description": "Published and acknowledged",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PublishAckDto" } }
            }
          },
          "400": { "description": "Reading failed validation" },
          "503": { "description": "No MQTT acknowledgement (broker unreachable?)" }
        },
        "summary": "Publish a reading via MQTT and wait for the ingest acknowledgement",
        "tags": ["telemetry"]
      }
    },
