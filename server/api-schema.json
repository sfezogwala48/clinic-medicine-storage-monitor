  "info": {
    "title": "Clinic Medicine Storage Monitor API",
    "description": "Medicine storage telemetry ingested over MQTT, exposed over HTTP, with sqlite persistence.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    { "name": "health", "description": "Liveness and readiness probes" },
    { "name": "telemetry", "description": "Storage device readings" },
    { "name": "sensors", "description": "Sensor registry" },
    { "name": "readings", "description": "Latest readings and temperature trend" },
    { "name": "alerts", "description": "Threshold violations" },
    { "name": "access", "description": "Container access events" },
    { "name": "notifications", "description": "SMS and buzzer dispatch log" },
    { "name": "dashboard", "description": "Dashboard aggregates" },
    { "name": "settings", "description": "Thresholds and notification settings" },
    { "name": "users", "description": "System users and audit trail" },
    { "name": "auth", "description": "Demo role login" }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "ReadingDto": {
        "type": "object",
        "properties": {
          "deviceId": { "type": "string", "example": "fridge-01" },
          "temperatureC": { "type": "number", "example": 4.5 },
          "humidityPct": { "type": "number", "example": 60 },
          "recordedAt": { "type": "string", "example": "2026-09-06T07:00:00.000Z" }
        },
        "required": ["deviceId", "temperatureC", "humidityPct", "recordedAt"]
      },
      "PublishReadingDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "example": "fridge-01",
            "description": "Storage device id (also encoded in the MQTT topic)"
          },
          "temperatureC": {
            "type": "number",
            "example": 4.5,
            "minimum": -30,
            "maximum": 80,
            "description": "Temperature in Celsius"
          },
          "humidityPct": {
            "type": "number",
            "example": 60,
            "minimum": 0,
            "maximum": 100,
            "description": "Relative humidity in percent"
          },
          "recordedAt": {
            "type": "string",
            "example": "2026-09-06T07:00:00.000Z",
            "description": "ISO timestamp; defaults to server time when omitted"
          }
        },
        "required": ["deviceId", "temperatureC", "humidityPct"]
      },
      "PublishAckDto": {
        "type": "object",
        "properties": {
          "published": { "type": "boolean", "example": true },
          "ack": { "type": "object", "example": { "received": true, "deviceId": "fridge-01" } }
        },
        "required": ["published", "ack"]
      },
      "SensorDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "SEN001" },
          "type": { "type": "string", "enum": ["Temp/Humidity", "Magnetic Door"] },
          "location": { "type": "string", "example": "Medicine Storage Room A" },
          "model": { "type": "string", "example": "SHT31" },
          "status": { "type": "string", "enum": ["Active", "Inactive"] }
        },
        "required": ["id", "type", "location", "model", "status"]
      },
      "CreateSensorDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "SEN004" },
          "type": { "type": "string", "enum": ["Temp/Humidity", "Magnetic Door"] },
          "location": { "type": "string", "example": "Medicine Storage Room A" },
          "model": { "type": "string", "example": "SHT31" },
          "status": { "type": "string", "enum": ["Active", "Inactive"], "default": "Active" },
          "container": { "type": "string", "example": "Medicine Cabinet A" }
        },
        "required": ["id", "type", "location", "model"]
      },
      "UpdateSensorDto": {
        "type": "object",
        "properties": {
          "location": { "type": "string", "example": "Medicine Storage Room B" },
          "model": { "type": "string", "example": "SHT31" },
          "status": { "type": "string", "enum": ["Active", "Inactive"] },
          "container": { "type": "string", "example": "Medicine Cabinet A" }
        }
      },
      "ThresholdsDto": {
        "type": "object",
        "properties": {
          "fridgeMin": { "type": "number", "example": 2 },
          "fridgeMax": { "type": "number", "example": 8 },
          "roomMax": { "type": "number", "example": 25 },
          "doorOpenLimitMin": { "type": "number", "example": 5 }
        },
        "required": ["fridgeMin", "fridgeMax", "roomMax", "doorOpenLimitMin"]
      },
      "NotificationSettingsDto": {
        "type": "object",
        "properties": {
          "smsEnabled": { "type": "boolean", "example": true },
          "buzzerEnabled": { "type": "boolean", "example": true },
          "emailEnabled": { "type": "boolean", "example": false },
          "recipients": {
            "example": ["+27731234567"],
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["smsEnabled", "buzzerEnabled", "emailEnabled", "recipients"]
      },
      "LoginDto": {
        "type": "object",
        "properties": { "role": { "type": "string", "enum": ["admin", "supervisor", "staff"] } },
        "required": ["role"]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number", "example": 1 },
          "name": { "type": "string", "example": "Dr. Ajibola" },
          "role": { "type": "string", "enum": ["admin", "supervisor", "staff"] },
          "contact": { "type": "string", "example": "admin@clinic.co.za" },
          "lastLogin": { "type": "object", "example": "2026-06-02T08:00:00.000Z" },
          "status": { "type": "string", "enum": ["Active", "Disabled"] }
        },
        "required": ["id", "name", "role", "contact", "lastLogin", "status"]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Nurse Khumalo" },
          "role": {
            "type": "string",
            "enum": ["admin", "supervisor", "staff"],
            "default": "staff"
          },
          "contact": { "type": "string", "example": "+27730000000" }
        },
        "required": ["name"]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Nurse Khumalo" },
          "role": { "type": "string", "enum": ["admin", "supervisor", "staff"] },
          "contact": { "type": "string", "example": "+27730000000" },
          "status": { "type": "string", "enum": ["Active", "Disabled"] }
        }
      },
      "AuditDto": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "example": "2026-06-02 09:45:20" },
          "user": { "type": "string", "example": "System" },
          "action": { "type": "string", "example": "Alert Triggered" },
          "details": { "type": "string", "example": "Unauthorized Access SEN006" }
        },
        "required": ["timestamp", "user", "action", "details"]
      },
      "NotificationDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "NOT007" },
          "alertId": { "type": "string", "example": "ALT006" },
          "type": { "type": "string", "enum": ["SMS", "Buzzer"] },
          "recipient": { "type": "string", "example": "+27731234567" },
          "message": {
            "type": "string",
            "example": "ALERT: Vaccine Container unauthorized access detected"
          }
        },
        "required": ["id", "alertId", "type", "recipient", "message"]
      },
      "AlertDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "ALT001" },
          "sensorId": { "type": "string", "example": "SEN001" },
          "type": { "type": "string", "example": "High Temperature" },
          "value": { "type": "string", "example": "25.1°C" },
          "time": {
            "type": "string",
            "example": "2026-06-02T08:15:00.000Z",
            "description": "ISO 8601 (UI formats it)"
          },
          "severity": { "type": "string", "enum": ["Critical", "High", "Medium"] },
          "status": { "type": "string", "enum": ["Active", "Resolved"] }
        },
        "required": ["id", "sensorId", "type", "value", "time", "severity", "status"]
      },
      "AccessEventDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "CST002" },
          "sensorId": { "type": "string", "example": "SEN005" },
          "container": { "type": "string", "example": "Medicine Cabinet A" },
          "open": { "type": "boolean", "example": true },
          "time": { "type": "string", "example": "2026-06-02T08:15:30.000Z" },
          "duration": { "type": "string", "example": "5m" },
          "reason": { "type": "string", "example": "Staff access" }
        },
        "required": ["id", "sensorId", "container", "open", "time", "duration", "reason"]
      },
      "SensorReadingDto": {
        "type": "object",
        "properties": {
          "sensorId": { "type": "string", "example": "SEN001" },
          "temp": { "type": "number", "example": 25.1 },
          "humidity": { "type": "number", "example": 49 },
          "containerOpen": { "type": "boolean", "example": false },
          "status": { "type": "string", "enum": ["Normal", "Warning", "Critical"] },
          "alerts": { "type": "number", "example": 0 }
        },
        "required": ["sensorId", "status", "alerts"]
      },
      "TemperatureSeriesDto": {
        "type": "object",
        "properties": {
          "sensorId": { "type": "string", "example": "SEN001" },
          "unit": { "type": "string", "example": "°C" },
          "intervalMinutes": { "type": "number", "example": 120 },
          "limit": { "type": "number", "example": 25 },
          "points": { "example": [22, 23, 24], "type": "array", "items": { "type": "string" } }
        },
        "required": ["sensorId", "unit", "intervalMinutes", "limit", "points"]
      },
      "DashboardSummaryDto": {
        "type": "object",
        "properties": {
          "avgTemperature": { "type": "number", "example": 22.5 },
          "avgHumidity": { "type": "number", "example": 45.2 },
          "humidityRange": { "type": "object", "example": { "min": 30, "max": 60 } },
          "activeAlerts": { "type": "number", "example": 2 },
          "criticalCount": { "type": "number", "example": 1 },
          "highCount": { "type": "number", "example": 1 },
          "systemStatus": { "type": "string", "enum": ["Online", "Offline", "Degraded"] },
          "lastSync": { "type": "string", "example": "2026-06-02T08:15:00.000Z" }
        },
        "required": [
          "avgTemperature",
          "avgHumidity",
          "humidityRange",
          "activeAlerts",
          "criticalCount",
          "highCount",
          "systemStatus",
          "lastSync"
        ]
      }
    }
  }
}
